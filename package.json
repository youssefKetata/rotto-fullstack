{
  "name": "rotto-fullstack-task-youssef",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node --env-file=.env.local --conditions=react-server --import tsx --test tests/database/schema.test.mjs tests/database/saved-search-migration.test.mjs tests/database/search-execution.test.ts tests/database/search-races.test.ts",
    "test:shortlists": "node --env-file=.env.local --conditions=react-server --import tsx --test tests/database/shortlist-membership.test.ts",
    "test:connection": "node --conditions=react-server --import tsx --test tests/supabase/connection.test.ts",
    "test:auth-unit": "node --conditions=react-server --import tsx --test tests/supabase/auth-response.test.ts",
    "test:auth": "node --test tests/supabase/login.test.mjs",
    "test:search-unit": "node --conditions=react-server --import tsx --test tests/search/interpretation.test.ts tests/search/billing.test.ts tests/search/requirement-editor.test.ts tests/search/saved-search.test.ts tests/search/workspace-session.test.ts tests/search/work-history-evidence.test.ts",
    "test:api": "node --env-file=.env.local --test tests/search/api.test.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "typecheck": "tsc --noEmit",
    "test:http": "node --conditions=react-server --import tsx --test tests/http/request-body.test.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" eslint.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "^2.1.1",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
